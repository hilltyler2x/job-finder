# Supabase project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud OAuth client (same one you give Supabase)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Free Gemini API key from aistudio.google.com
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash)
GEMINI_MODEL=

# Optional, free: Adzuna job listings across the US (developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Any long random string; Vercel sends it to the daily job
CRON_SECRET=

# Your site's address, e.g. https://job-finder.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email shown on the privacy page for questions
NEXT_PUBLIC_CONTACT_EMAIL=
